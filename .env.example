# Resend API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxx

# Inbox that receives estimate form submissions
LEAD_TO_EMAIL=estimating@covenantbuilders.org

# From address (use a Resend-verified domain, or onboarding@resend.dev while testing)
LEAD_FROM_EMAIL=Covenant Builders <noreply@covenantbuilders.org>

# Public site URL (used in metadata / sitemap)
NEXT_PUBLIC_SITE_URL=https://covenantbuilders.org

# Optional — Google Search Console HTML tag verification value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---- CRM (Supabase) — publishable/anon key only, never the service-role key
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# ---- Covenant Assistant (docs/assistant.md)
# Claude's key from https://console.anthropic.com — server-only, billed per use
ANTHROPIC_API_KEY=sk-ant-xxxx
# The lock: same long random string you inserted into assistant_config in Supabase.
# The page lives at /assistant/<ASSISTANT_SECRET>
ASSISTANT_SECRET=
# Optional — which Claude model the assistant thinks with
ASSISTANT_MODEL=claude-sonnet-5
